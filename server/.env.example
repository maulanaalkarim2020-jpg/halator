# Environment Configuration for Halator Backend
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Contoh: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/halator?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/halator

# JWT Secret Key for token signing
JWT_SECRET=halator_secure_jwt_secret_key_2026_xyz987

# Token Expiry (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin for CORS (comma-separated or * for all)
CORS_ORIGIN=*
